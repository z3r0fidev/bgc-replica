# Database (separate from main app)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bgc_personals

# Redis (can share with main app)
REDIS_URL=redis://localhost:6379/0

# Security Keys (MUST match main app for shared auth)
SECRET_KEY=your-32-char-hex-key-here
NEXTAUTH_SECRET=same-as-frontend-AUTH_SECRET

# Optional
SENTRY_DSN=
DEBUG=false
