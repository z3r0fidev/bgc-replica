# API URLs (port 8001 for bgc-personals backend)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=http://127.0.0.1:8001

# Auth (MUST match main app for shared auth)
AUTH_SECRET=your-auth-secret-here
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Database (separate from main app)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bgc_personals

# Optional
SENTRY_DSN=
