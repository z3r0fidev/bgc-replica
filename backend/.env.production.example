# Production Environment Variables for Backend
# Copy to .env and fill in actual values

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://default:password@host:6379

# Security
SECRET_KEY=your-secret-key-min-32-chars
NEXTAUTH_SECRET=same-as-frontend-AUTH_SECRET

# Email (Resend)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@bgclive.online
# From the Resend dashboard's webhook settings, once the endpoint
# (POST /api/webhooks/resend) is registered there.
RESEND_WEBHOOK_SECRET=whsec_xxxxx

# Storage (Supabase)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your-service-role-key
MEDIA_BUCKET_NAME=bgclive-media

# Monitoring
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
ENABLE_OTEL=true

# App Settings
APP_URL=https://bgclive.online
CORS_ORIGINS=["https://bgclive.online"]
